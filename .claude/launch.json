{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace=@atlas/web"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "web-codex",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--workspace=@atlas/web",
        "--",
        "-p",
        "3001"
      ],
      "port": 3001,
      "env": {
        "NEXT_DIST_DIR": ".next-codex"
      }
    }
  ]
}
